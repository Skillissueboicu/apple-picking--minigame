<Project>
  <!--
    obj\ under projektroden kan være låst/uden ACL (fx "Access denied" på refint).
    Flyt intermediate + output til .build\ *før* SDK importeres — se MSB3539.
  -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory).build\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory).build\bin\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prevent generated intermediates from being compiled as source files -->
    <Compile Remove=".build\**\*.cs" />
    <Compile Remove="_b\**\*.cs" />
  </ItemGroup>
</Project>
